NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cattle_farm?replicaSet=rs0
CORS_ORIGIN=http://localhost:3000
TZ=Asia/Ho_Chi_Minh

JWT_ACCESS_SECRET=change_me_long_random
JWT_ACCESS_EXPIRES=15m
REFRESH_TTL_DAYS=7

OTP_SECRET=change_me_long_random
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Để trống SMTP_HOST thì OTP được in ra console (chỉ dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cattle-farm.local

# Dùng cho npm run seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
ADMIN_FULL_NAME=Quan tri vien
